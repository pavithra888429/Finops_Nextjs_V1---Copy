      "id": "code.execute-1790220334002002",
      "data": {
        "label": "Code",
        "inputs": {
          "code": "const input = (typeof $json !== 'undefined' && ($json.body || $json)) || {};\n\nconst region = input.region || 'us-east-1';\nconst connectionName = input.connectionName || 'Production AWS Account';\nconst awsAccountId = input.awsAccountId || '';\nconst roleName = input.roleName || 'FinOpsAwsIntegrationRole';\nconst stackName = input.stackName || connectionName.replace(/[^a-zA-Z0-9-]/g, '-');\nconst userId = input.userId || 'default_user';\nconst provider = input.provider || 'aws';\nconst setupMethod = input.setupMethod || 'cloudformation';\nconst platformAccountId = input.platformAccountId || '864981730114';\nconst templateUrl = input.templateUrl || 'https://square-pulse-public.s3.ap-south-1.amazonaws.com/templates/finops-aws-cloud-cost-role.yaml';\n\n// Generate unique session IDs\nconst randHex = Math.random().toString(36).substring(2, 14);\nconst connectionId = input.connectionId || `conn_${randHex}`;\nconst externalId = input.externalId || `ext_${randHex}${Math.random().toString(36).substring(2, 14)}`;\n\n// Build AWS 1-Click Quick-Create URL\nconst queryParts = [\n  'templateURL=' + encodeURIComponent(templateUrl),\n  'stackName=' + encodeURIComponent(stackName),\n  'param_PlatformAccountId=' + encodeURIComponent(platformAccountId),\n  'param_ExternalId=' + encodeURIComponent(externalId),\n  'param_IAMRoleName=' + encodeURIComponent(roleName)\n];\nconst queryString = queryParts.join('&');\nconst cloudFormationLaunchUrl = `https://${region}.console.aws.amazon.com/cloudformation/home?region=${region}#/stacks/quickcreate?${queryString}`;\n\nreturn {\n  success: true,\n  userId,\n  connectionId,\n  externalId,\n  platformAccountId,\n  awsAccountId,\n  roleName,\n  stackName,\n  region,\n  connectionName,\n  cloudFormationLaunchUrl,\n  provider,\n  setupMethod,\n  status: 'cloudformation_pending',\n  roleStatus: 'unverified',\n  createdAt: new Date().toISOString()\n};\n",
          "mode": "all",
          "language": "javascript"
        },
