        "label": "Code",
        "inputs": {
          "code": "// 1. Get raw input from previous node (Http Request)\nconst raw = (typeof $input !== 'undefined' && $input?.first?.()?.json) || \n            (typeof input !== 'undefined' && (input?.[0]?.json || input?.[0] || input)) || \n            (typeof $json !== 'undefined' && $json) || \n            {};\n\n// 2. Correctly extract AssumeRoleResponse from raw.body\nconst stsData = raw.body || raw.data || raw;\nconst assumeResult = stsData?.AssumeRoleResponse?.AssumeRoleResult || \n                     stsData?.AssumeRoleResult || \n                     stsData;\n\nconst credentials = assumeResult?.Credentials;\nconst assumedRoleUser = assumeResult?.AssumedRoleUser;\n\n// 3. Extract Account ID and Role directly from the AWS STS AssumedRoleUser ARN!\nconst arn = assumedRoleUser?.Arn || '';\nconst arnParts = arn.split(':');\nconst extractedAccountId = arnParts[4] || '';\nconst extractedRoleName = (arnParts[5] ? arnParts[5].split('/')[1] : null) || 'FinOpsAwsIntegrationRole';\nconst fullRoleArn = `arn:aws:iam::${extractedAccountId}:role/${extractedRoleName}`;\n\n// 4. Safely extract connectionId from context if available\nlet connectionId = '';\ntry {\n  if (typeof context !== 'undefined' && context) {\n    connectionId = context?.nodes?.['Webhook Trigger']?.json?.body?.connectionId || \n                   context?.steps?.['Webhook Trigger']?.body?.connectionId || \n                   '';\n  }\n} catch (e) {}\n\n// 5. Success: SessionToken exists!\nif (credentials?.SessionToken) {\n  return {\n    success: true,\n    status: 'connected',\n    roleStatus: 'verified',\n    awsAccountId: extractedAccountId,\n    roleArn: fullRoleArn,\n    connectionId: $node[\"webhook-1790220595488005\"].json[\"body\"][\"connectionId\"]  ,\n    assumedRoleUserArn: arn,\n    sessionTokenReceived: true,\n    verifiedAt: new Date().toISOString()\n  };\n}\n\n// 6. Failure fallback\nconst errMsg = stsData?.ErrorResponse?.Error?.Message || stsData?.Error?.Message || stsData?.message || 'AccessDenied';\nconst errCode = stsData?.ErrorResponse?.Error?.Code || stsData?.Error?.Code || 'AccessDenied';\n\nreturn {\n  success: false,\n  status: 'verification_failed',\n  roleStatus: 'failed',\n  awsAccountId: extractedAccountId,\n  roleArn: fullRoleArn,\n  connectionId:  $node[\"webhook-1790220595488005\"].json[\"body\"][\"connectionId\"] ,\n  lastError: {\n    errorCode: errCode,\n    message: errMsg\n  }\n};\n",
