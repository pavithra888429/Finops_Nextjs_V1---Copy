        "label": "Code",
        "inputs": {
          "code": "// ==============================================================================\n// Multi-Tenant AWS STS & S3 Verification - Code Node\n// ==============================================================================\n\n// 1. Extract STS HTTP response from previous Http Request node\nconst raw = (typeof $input !== 'undefined' && $input?.first?.()?.json) || \n            (typeof input !== 'undefined' && (input?.[0]?.json || input?.[0] || input)) || \n            (typeof $json !== 'undefined' && $json) || \n            {};\n\nconst stsResponse = raw.data || raw.body || raw;\n\n// 2. Extract Webhook payload from Webhook Trigger node\nlet webhookInput = {};\n\ntry {\n  if (typeof $node !== 'undefined' && $node) {\n    const triggerNode = $node['Webhook Trigger'] || \n                        $node['webhook-1790318779156001'] || \n                        $node['Webhook'] || \n                        $node['Trigger'];\n    if (triggerNode?.json) {\n      webhookInput = triggerNode.json.body || triggerNode.json;\n    }\n\n    if (!webhookInput?.connectionId && !webhookInput?.awsAccountId) {\n      for (const k of Object.keys($node)) {\n        const item = $node[k]?.json?.body || $node[k]?.json;\n        if (item && (item.connectionId || item.awsAccountId || item.externalId)) {\n          webhookInput = item;\n          break;\n        }\n      }\n    }\n  }\n} catch (e) {}\n\nif (!webhookInput?.connectionId && !webhookInput?.awsAccountId) {\n  try {\n    if (typeof $ === 'function') {\n      const candidates = ['Webhook Trigger', 'webhook-1790318779156001', 'Webhook'];\n      for (const name of candidates) {\n        try {\n          const item = $(name)?.first();\n          if (item?.json) {\n            const b = item.json.body || item.json;\n            if (b && (b.connectionId || b.awsAccountId || b.externalId)) {\n              webhookInput = b;\n              break;\n            }\n          }\n        } catch (err) {}\n      }\n    }\n  } catch (e) {}\n}\n\n// 3. Extract STS AssumeRole credentials & caller identity\nconst assumeResult = stsResponse?.AssumeRoleResponse?.AssumeRoleResult || \n                     stsResponse?.AssumeRoleResult || \n                     stsResponse?.body?.AssumeRoleResponse?.AssumeRoleResult || \n                     null;\n\nconst assumedRoleUser = assumeResult?.AssumedRoleUser || null;\nconst assumedArn = assumedRoleUser?.Arn || '';\nconst isRoleAssumed = Boolean(assumeResult?.Credentials && assumedArn);\n\n// Extract real AWS Account ID and Role Name directly from live ARN\nlet liveAwsAccountId = '';\nlet liveRoleName = '';\n\nif (assumedArn) {\n  const arnParts = assumedArn.split(':');\n  liveAwsAccountId = arnParts[4] || '';\n  if (arnParts[5]) {\n    const pathParts = arnParts[5].split('/');\n    liveRoleName = pathParts[1] || '';\n  }\n}\n\nliveAwsAccountId = liveAwsAccountId || webhookInput.awsAccountId || '';\nliveRoleName = liveRoleName || webhookInput.roleName || 'FinOpsAwsIntegrationRole';\nconst connectionId = webhookInput.connectionId || '';\nconst externalId = webhookInput.externalId || '';\nconst region = webhookInput.region || 'us-east-1';\nconst bucketName = webhookInput.bucketName || '';\nconst exportName = webhookInput.exportName || '';\n\n// 4. Verify S3 Bucket & Policy (True when role is assumed and bucket configured)\nconst isBucketConfigured = Boolean(bucketName && bucketName.trim().length > 0);\nconst isBucketCreated = isRoleAssumed && isBucketConfigured;\n\n// 5. Build dynamic status flags\nconst roleStatus = isRoleAssumed ? 'verified' : 'unverified';\nconst s3BucketStatus = (isRoleAssumed && isBucketConfigured) ? 'active' : 'pending';\nconst cloudCostStatus = (isRoleAssumed && isBucketConfigured) ? 'verified' : 'pending';\nconst exportStatus = (isRoleAssumed && isBucketConfigured) ? 'active' : 'pending';\nconst overallStatus = isRoleAssumed ? 'connected' : 'verification_failed';\n\nconst nowIso = new Date().toISOString();\n\n// 6. Return dynamic pay