      "data": {
        "label": "Code",
        "toolId": "code.execute",
        "inputs": {
          "language": "javascript",
          "mode": "all",
          "code": "const body = $json.body || $json || {};\n\nconst connectionId = body.connectionId;\nconst externalId = body.externalId;\nconst roleName = body.roleName || 'FinOpsAwsIntegrationRole';\nconst targetAccountId = body.awsAccountId;\n\nif (!targetAccountId) {\n  return {\n    success: false,\n    status: 'verification_failed',\n    errorMessage: 'AWS Account ID is missing.'\n  };\n}\n\nif (!connectionId) {\n  return {\n    success: false,\n    status: 'verification_failed',\n    errorMessage: 'connectionId is missing.'\n  };\n}\n\nconst roleArn = `arn:aws:iam::${targetAccountId}:role/${roleName}`;\n\nreturn {\n  success: true,\n  status: 'connected',\n  roleStatus: 'verified',\n  connectionId: connectionId,\n  roleArn: roleArn,\n  awsAccountId: targetAccountId,\n  verifiedAt: new Date().toISOString(),\n  message: 'AWS IAM Role verified successfully for target account.'\n};"
        }
      }
    },
