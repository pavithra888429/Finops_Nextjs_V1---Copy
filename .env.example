# ==============================================================================
# FinOps Analytics Platform - Environment Configuration Template (.env.example)
# Copy this file to .env.local or .env and update values accordingly
# ==============================================================================

# Application Port
PORT=3005
NODE_ENV=development

# ------------------------------------------------------------------------------
# Backend API Base URL
# ------------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# AWS CloudFormation & Multi-Cloud Connectors
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PLATFORM_ACCOUNT_ID=864981730114
NEXT_PUBLIC_FINOPS_PLATFORM_ACCOUNT_ID=864981730114

# Phase 1: IAM Role CloudFormation Template S3/HTTPS URL
NEXT_PUBLIC_FINOPS_CFN_TEMPLATE_URL=https://square-pulse-public.s3.ap-south-1.amazonaws.com/templates/finops-aws-cloud-cost-role.yaml

# Phase 2: CUR 2.0 / Data Export CloudFormation Template S3/HTTPS URL
NEXT_PUBLIC_FINOPS_CFN_CUR2_TEMPLATE_URL=https://square-pulse-public.s3.ap-south-1.amazonaws.com/templates/finops-aws-cloud-cost-cur2.yaml

# Webhooks for AWS Connection & Verification
NEXT_PUBLIC_AWS_START_WEBHOOK_URL=https://pavikali.app.n8n.cloud/webhook/finops-aws-start
NEXT_PUBLIC_AWS_VERIFY_WEBHOOK_URL=https://testapi.agents.snsihub.ai/webhook/ce70f5bf-900e-46ab-bf1b-aa475f91b11d

# ------------------------------------------------------------------------------
# OpenRouter AI Gateway Telemetry Webhooks
# ------------------------------------------------------------------------------
NEXT_PUBLIC_OPENROUTER_VERIFY_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/708dc830-0fa9-4ca8-8420-a52497ffbe40
NEXT_PUBLIC_OPENROUTER_SYNC_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/708dc830-0fa9-4ca8-8420-a52497ffbe40
NEXT_PUBLIC_OPENROUTER_TELEMETRY_WEBHOOK_URL=https://api.agents.snsihub.ai/webhook/708dc830-0fa9-4ca8-8420-a52497ffbe40
