    {
      "id": "code.execute-1790308975024002",
      "data": {
        "label": "Code",
        "inputs": {
          "code": "// ==============================================================================\n// Phase 2: Configure Cloud Cost Pipeline - Code Node\n// Pure live data extraction (zero mock / zero hardcoded fallbacks)\n// ==============================================================================\n\n// 1. Extract payload from incoming webhook\nconst raw = (typeof $input !== 'undefined' && $input?.first?.()?.json) || \n            (typeof input !== 'undefined' && (input?.[0]?.json || input?.[0] || input)) || \n            (typeof $json !== 'undefined' && $json) || \n            {};\n\nconst body = raw.body || raw || {};\n\n// 2. Read exact properties sent from frontend (no synthetic defaults)\nconst connectionId = body.connectionId || '';\nconst awsAccountId = body.awsAccountId || '';\nconst bucketName = body.bucketName || '';\nconst region = body.bucketRegion || body.region || 'us-east-1';\nconst exportName = body.exportName || '';\nconst exportPathPrefix = body.exportPathPrefix || '';\nconst roleName = body.roleName || '';\nconst kmsKeyArn = body.kmsKeyArn || '';\nconst createCur = body.createCur !== false;\nconst createS3 = body.createS3 !== false;\n\n// 3. Phase 2 CloudFormation Template URL\nconst templateUrl = 'https://square-pulse-public.s3.ap-south-1.amazonaws.com/templates/finops-aws-cloud-cost-cur2.yaml';\n\n// 4. Build AWS 1-Click Launch URL dynamically (only include present parameters)\nconst queryParts = [\n  'templateURL=' + encodeURIComponent(templateUrl),\n  'stackName=FinOpsCloudCostStack'\n];\n\nif (bucketName) queryParts.push('param_S3BucketName=' + encodeURIComponent(bucketName));\nif (exportName) queryParts.push('param_ExportName=' + encodeURIComponent(exportName));\nif (roleName) queryParts.push('param_IAMRoleName=' + encodeURIComponent(roleName));\nif (kmsKeyArn) queryParts.push('param_KmsKeyArn=' + encodeURIComponent(kmsKeyArn));\n\nconst queryString = queryParts.join('&');\nconst cloudFormationLaunchUrl = `https://${region}.console.aws.amazon.com/cloudformation/home?region=${region}#/stacks/quickcreate?${queryString}`;\n\n// 5. Return clean object directly for MongoDB Update & Response\nreturn {\n  success: true,\n  connectionId,\n  awsAccountId,\n  bucketName,\n  bucketRegion: region,\n  exportName,\n  exportPathPrefix,\n  roleName,\n  createCur,\n  createS3,\n  cloudFormationLaunchUrl,\n  status: 'cloudformation_step2_pending',\n  updatedAt: new Date().toISOString()\n};\n",
          "mode": "all",
          "language": "javascript"
        },
        "toolId": "code.execute",
        "toolData": {
